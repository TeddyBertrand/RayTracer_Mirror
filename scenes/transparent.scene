camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 1.0; z = 6.0; }; # Plus proche pour mieux voir
    look_at = { x = 0.0; y = 0.5; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 40.0;
};

materials: (
    { id = "floor_grey"; type = "flat_color"; color = { r = 100.0; g = 100.0; b = 100.0; }; },
    
    { id = "glass"; type = "transparent"; color = { r = 255.0; g = 255.0; b = 255.0; }; ref = 1.1; },
    
    { id = "red"; type = "flat_color"; color = { r = 255.0; g = 0.0; b = 0.0; }; },
    { id = "green"; type = "flat_color"; color = { r = 0.0; g = 255.0; b = 0.0; }; }
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = -1.0; z = 0.0; }; material = "floor_grey"; },

    { type = "sphere"; position = { x = 0.0; y = 0.5; z = 0.0; }; radius = 1.2; material = "glass"; },

    { type = "sphere"; position = { x = 0.8; y = 0.2; z = -2.0; }; radius = 0.8; material = "red"; },

    { type = "sphere"; position = { x = -2.0; y = 0.0; z = -1.0; }; radius = 0.5; material = "green"; }
);

sky = {
    type = "atmospheric";
    groundColor = { r = 20.0; g = 20.0; b = 30.0; }; 
    zenithColor = { r = 40.0; g = 50.0; b = 80.0; };
};

lights: (
    {
        type = "point";
        position = { x = 5.0; y = 5.0; z = 5.0; };
        color = { r = 255.0; g = 255.0; b = 255.0; };
        intensity = 2.5;
    }
);

render = {
    samples = 128; 
    max_depth = 50;
};