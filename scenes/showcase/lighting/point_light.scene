camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 2.0; z = 10.0; };
    look_at = { x = 0.0; y = 0.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 50.0;
};

materials: (
    { id = "floor_white"; type = "flat_color"; color = { r = 200.0; g = 200.0; b = 200.0; }; },
    { id = "bright_blue"; type = "flat_color"; color = { r = 0.0; g = 100.0; b = 255.0; }; }
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = -1.5; z = 0.0; }; material = "floor_white"; },
    { 
        type = "sphere"; 
        position = { x = 4.0; y = 0.5; z = 0.0; }; 
        rotation = { x = 0.0; y = 45.0; z = 0.0; };
        radius = 2.0
        material = "bright_blue"; 
    },
    { 
        type = "sphere"; 
        position = { x = -4.0; y = 0.5; z = 0.0; }; 
        rotation = { x = 0.0; y = 45.0; z = 0.0; };
        radius = 2.0
        material = "bright_blue"; 
    },


);

sky = {
    type = "empty";
};

lights: (
    { type = "point"; position = { x = 0.0; y = 1.0; z = 0.0; }; color = { r = 255.0; g = 255.0; b = 255.0; }; intensity = 1.0 }
);

render = {
    samples = 64;
    ao_samples = 16;
};
