
camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 10.0; z = 40.0; };
    look_at = { x = 0.0; y = 0.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 45.0;
};

materials: (
    { id = "white"; type = "flat_color"; color = { r = 155.0; g = 155.0; b = 155.0; }; randomness = 2.0; },
);

shapes: (
    { type = "mesh"; position = { x = 0.0; y = 0.5; z = 0.0; }; rotation = { x = 0.0; y = 0.0; z = 0.0; }; material = "white"; file = "assets/obj/bin/corbeille.obj"; }
);

lights: (
    { type = "directional"; position = { x = 60.0; y = 60.0; z = 60.0; }; rotation = {x = 45.0, y = 90.0; z = 0.0}; color = { r = 255.0; g = 255.0; b = 255.0; }; intensity = 8.0; },
);

sky = {
    type = "atmospheric";
    nebulaColor = { r = 0.02; g = 0.02; b = 0.05; };
};

render = {
    samples = 16;
    adaptive_threshold = 0.05;
};
