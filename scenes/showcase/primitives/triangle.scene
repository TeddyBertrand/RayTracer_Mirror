camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 2.0; z = 10.0; };
    look_at = { x = 0.0; y = 0.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 50.0;
};

materials: (

    { id = "floor_white"; type = "flat_color"; color = { r = 200.0; g = 200.0; b = 200.0; }; },
    { id = "bright_blue"; type = "flat_color"; color = { r = 0.0; g = 100.0; b = 255.0; }; },
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = -1.5; z = 0.0; }; material = "floor_white"; },
    { 
        type = "triangle"; 
        v0 = { x = 0.0; y = 0.0; z = 0.0; };
        v1 = { x = 4.0; y = 0.0; z = 0.0; };
        v2 = { x = 0.0; y = 4.0; z = 0.0; };
        position = { x = 0.0; y = 0.5; z = 0.0; }; # Déplacé par l'entity
        rotation = { x = 0.0; y = 45.0; z = 0.0; }; # Tourné par l'entity
        material = "bright_blue";
    },
);

sky = {
    type = "atmospheric";
    groundColor = { r = 120.0; g = 150.0; b = 205.0; };
    zenithColor = { r = 105.0; g = 105.0; b = 205.0; };
};

lights: (
    {
        type = "directional";
        rotation = { x = 35.0; y = 30.0; z = 0.0 };
        color = { r = 255.0; g = 255.0; b = 255.0; };
        intensity = 1.8;
    },
);

render = {
    samples = 64;
    ao_samples = 16;
};
