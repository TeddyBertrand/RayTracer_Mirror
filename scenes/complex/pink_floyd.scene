camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 2.0; z = 10.0; };
    look_at = { x = 0.0; y = 0.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 50.0;
};

materials: (

    { id = "floor_white"; type = "flat_color"; color = { r = 200.0; g = 200.0; b = 200.0; }; },
    { id = "bright_blue"; type = "flat_color"; color = { r = 0.0; g = 100.0; b = 255.0; }; },
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = 0.0; z = 0.0; }; rotation = { x = 0.0; y = 0.0; z = 0.0; }; material = "floor_white"; },
    
    { type = "plane"; position = { x = 0.0; y = 0.0; z = -20.0; }; rotation = { x = 90.0; y = 0.0; z = 0.0; }; material = "floor_white"; },
    { 
        type = "import"; path = "scenes/library/blueprints/objects/pyramid.scene"; name = "pyramid";
        position = { x = -4.0; y = 1.0; z = 0.0; };
        rotation = { x = 0.0; y = 0.0; z = 0.0; };
        scale = 1.0;
    },
    { 
        type = "import"; path = "scenes/library/blueprints/objects/pyramid.scene"; name = "pyramid";
        position = { x = -2.0; y = 1.0; z = 0.0; };
        rotation = { x = 0.0; y = 0.0; z = 0.0; };
        scale = 1.0;
    },
);

sky = {
    type = "empty";
};

lights: (
    {
        type = "spot"; position = { x = 4.0; y = 1.0; z = 0.0; };
