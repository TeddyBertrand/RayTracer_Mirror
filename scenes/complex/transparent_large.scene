camera:
{
    type = "perspective";
    width = 1280;
    height = 720;
    position = { x = 0.0; y = 3.0; z = 10.0; };
    look_at = { x = 0.0; y = 1.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 45.0;
};

materials: (
    { id = "floor_dark"; type = "flat_color"; color = { r = 40.0; g = 40.0; b = 40.0; }; },
    { id = "glass"; type = "transparent"; color = { r = 255.0; g = 255.0; b = 255.0; }; ref = 1.5; },
    { id = "water"; type = "transparent"; color = { r = 180.0; g = 210.0; b = 255.0; }; ref = 1.33; },
    { id = "mirror"; type = "metal"; color = { r = 255.0; g = 255.0; b = 255.0; }; fuzz = 0.0; },
    { id = "red_plastic"; type = "flat_color"; color = { r = 255.0; g = 50.0; b = 50.0; }; },
    { id = "green_plastic"; type = "flat_color"; color = { r = 50.0; g = 255.0; b = 50.0; }; }
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = 0.0; z = 0.0; }; material = "floor_dark"; },

    { type = "sphere"; position = { x = 0.0; y = 1.5; z = 0.0; }; radius = 1.5; material = "glass"; },

    { type = "box"; position = { x = -1.5; y = 2.0; z = 1.0; }; scale = { x = 0.8; y = 0.8; z = 0.8; }; rotation = { x = 15.0; y = 45.0; z = 0.0; }; material = "water"; },

    { type = "box"; position = { x = 0.0; y = 2.5; z = -5.0; }; scale = { x = 10.0; y = 5.0; z = 0.1; }; material = "mirror"; },

    { type = "box"; position = { x = -4.0; y = 2.0; z = -2.0; }; scale = { x = 1.0; y = 4.0; z = 1.0; }; material = "red_plastic"; },

    { type = "box"; position = { x = 4.0; y = 2.0; z = -2.0; }; scale = { x = 1.0; y = 4.0; z = 1.0; }; material = "green_plastic"; }
);

sky = {
    type = "atmospheric";
    groundColor = { r = 30.0; g = 30.0; b = 40.0; };
    zenithColor = { r = 100.0; g = 130.0; b = 180.0; };
};

lights: (
    {
        type = "point";
        position = { x = 4.0; y = 8.0; z = 4.0; };
        color = { r = 255.0; g = 255.0; b = 255.0; };
        intensity = 3.0;
    },
    {
        type = "directional";
        rotation = { x = 45.0; y = -45.0; z = 0.0 };
        color = { r = 150.0; g = 150.0; b = 200.0; };
        intensity = 0.8;
    }
);

render = {
    samples = 256;
    max_depth = 64;
};