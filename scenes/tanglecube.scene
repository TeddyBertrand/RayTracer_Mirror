camera:
{
    type = "perspective";
    width = 1000;
    height = 800;
    position = { x = 0.0; y = 2.0; z = 10.0; };
    look_at = { x = 0.0; y = 0.0; z = 0.0; };
    up = { x = 0.0; y = 1.0; z = 0.0; };
    fieldOfView = 60.0;
};

materials: (
    { id = "tangle_mat"; type = "flat_color"; color = { r = 255.0; g = 100.0; b = 150.0; }; randomness = 0.5; },
    { id = "floor_mat"; type = "flat_color"; color = { r = 40.0; g = 40.0; b = 40.0; }; randomness = 0.1; }
);

lights: (
    { 
        type = "directional"; 
        rotation = { x = 45.0; y = 45.0; z = 0.0 };
        color = { r = 255.0; g = 255.0; b = 255.0; }; 
        intensity = 0.8;
    },
    {
        type = "point";
        position = { x = -4.0; y = 5.0; z = 4.0; };
        color = { r = 255.0; g = 255.0; b = 255.0; };
        intensity = 1.2;
    }
);

shapes: (
    { type = "plane"; position = { x = 0.0; y = -2.5; z = 0.0; }; material = "floor_mat"; },
    { 
        type = "tanglecube"; 
        position = { x = 0.0; y = 0.0; z = 0.0; }; 
        rotation = { x = 30.0; y = 45.0; z = 0.0; };
        scale = { x = 1.0; y = 1.0; z = 1.0; }; 
        material = "tangle_mat"; 
    }
);

sky = {
    type = "empty";
    color = { r = 10.0; g = 10.0; b = 20.0; };
};

render = {
    samples = 128;
}
